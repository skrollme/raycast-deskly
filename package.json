{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-deskly",
  "title": "desk.ly",
  "description": "Manage your desk.ly desk-sharing bookings",
  "icon": "command-icon.png",
  "author": "skroll",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "my-bookings",
      "title": "Next Bookings",
      "description": "Show my next Bookings",
      "mode": "view"
    },
    {
      "name": "todays-booking",
      "title": "Today's Bookings",
      "description": "Show my today's Booking",
      "mode": "no-view",
      "interval": "10m"
    }
  ],
  "preferences": [
    {
      "name": "apiUrl",
      "type": "textfield",
      "required": false,
      "default": "https://app.desk.ly",
      "title": "API URL",
      "description": "API URL of your desk.ly instance"
    },
    {
      "name": "refreshToken",
      "type": "textfield",
      "required": true,
      "title": "Refresh Token",
      "description": "Valid desk.ly Refresh Token which can be used for API Calls"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.57.1",
    "@raycast/utils": "^1.4.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.5",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
